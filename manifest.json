{
  "name": "Site Blocker",
  "description": "A Chrome extension to help you stay focused by blocking distracting sites.",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "image.png"
  },
  "content_scripts":[{
    "matches": [
      "*://*.youtube.com/*",
      "*://*.reddit.com/*",
      "*://*.instagram.com/*"
    ],
    "js": ["content.js"]
  }]
}