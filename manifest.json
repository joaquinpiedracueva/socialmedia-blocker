{
  "name": "socialmedia-blocker",
  "description": "",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "image.png"
  },
  "permissions": ["storage", "alarms"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"]
    },
    {
      "matches": [
        "*://*.instagram.com/*",
        "*://*.x.com/*",
        "*://*.twitter.com/*",
        "*://*.twitch.tv/*",
        "*://*.kick.com/*",
        "*://*.tiktok.com/*",
        "*://*.facebook.com/*",
        "*://*.netflix.com/*",
        "*://*.hbomax.com/*",
        "*://*.disneyplus.com/*",
        "*://*.primevideo.com/*"
      ],
      "js": ["block.js"],
      "run_at": "document_start"
    }
  ]
}
